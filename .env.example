# Скопируйте в .env и правьте под себя. Все переменные с префиксом ANPR_.

# ---------------------------------------------------------------- распознавание
ANPR_RECOGNIZER_WEIGHTS=best_accuracy.pth
# charset восстановлен по весам: string.printable[:94], класс 0 = CTC blank.
# Если номера читаются мусором — проверьте `python -m tools.probe_model --all-variants`.
# ANPR_CHARSET=0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!"#$%&'()*+,-./:;<=>?@[\]^_`{|}~
ANPR_PREPROCESS=resize          # resize | pad  (pad = сохранять пропорции и допаддить)
ANPR_CONTRAST_BOOST=false       # CLAHE перед распознаванием (помогает на тёмных кадрах)
ANPR_QUANTIZE=false             # int8 динамическая квантизация LSTM/Linear: быстрее на CPU
ANPR_TEXT_HEAD=anpr             # голова с текстом номера
ANPR_TYPE_HEAD=ctype            # вторая голова (алфавит: цифры + H + M)
# Алфавит второй головы (цифры + H + M) совпадает с алфавитом цветных номеров УЗ:
# зелёные (электромобили) 01 M 018461 и жёлтые (иностранцы) 01 H 018461. Для этих
# цветов её вывод идёт в кандидаты; побеждает только при совпадении с форматом.
# Замер: на 80 белых номерах включение ничего не портит (72/80 в обоих случаях).
# Гипотеза ПРОВЕРЕНА на 39 цветных (20 зелёных + 19 жёлтых) и НЕ ПОДТВЕРДИЛАСЬ:
# с головой 30/39, без неё 29/39, на жёлтых одинаково 14/19. Плюс один номер — шум.
# Оставлено включённым, потому что вреда нет, но улучшением это считать нельзя.
ANPR_TYPE_HEAD_COLORS=yellow,green
# Двухстрочные квадратные пластины (прицепы). Текущий чекпоинт их не читает (0/4),
# а на видео 36% кропов уходят на двойное чтение: 184 мс против 97. Включать после
# дообучения распознавателя.
ANPR_TWO_LINE=false

# --------------------------------------------------------------------- детектор
# Замер на 80 узбекских номерах (см. README): yolo11n 72/80 текст, lpr-yolov8n 66/80,
# детекция у обоих 80/80. Сравнить на своих данных: python -m tools.eval_uz --compare models/*.pt
ANPR_DETECTOR_WEIGHTS=models/yolo11n-plate.pt
# ANPR_DETECTOR_WEIGHTS=models/lpr-yolov8n-plate.pt   # YOLOv8n из репо Muhammad-Zeerak-Khan
ANPR_DET_IMGSZ=640
ANPR_DET_CONF=0.35
ANPR_DET_IOU=0.5
ANPR_DET_MAX_DET=20
# Второй проход, если на первом не нашлось НИЧЕГО: вытаскивает мелкие и косые пластины
# (грузовики, прицепы). На выборке УЗ поднял детекцию с 37/40 до 40/40. 0 = выключить.
ANPR_DET_RETRY_IMGSZ=1536
ANPR_DET_RETRY_CONF=0.10
# Второй проход стоит ~366 мс. Для одиночного фото это оправдано, для видео нет:
# кадр без пластины там норма, а следующий шанс придёт через 150 мс.
ANPR_DET_RETRY_IN_STREAM=false

# --------------------------------------------------------------------- пайплайн
ANPR_DEVICE=cpu                 # cuda / cuda:0 если есть GPU
ANPR_TORCH_THREADS=4
ANPR_WORKERS=2                  # потоков инференса
ANPR_CROP_PADDING=0.06
ANPR_MIN_PLATE_WIDTH=24
ANPR_REC_MIN_CONF=0.30
ANPR_FORMAT_CONSTRAINT=true     # выбирать вариант CTC, подходящий под формат номера УЗ
ANPR_BEAM_TOPK=3
ANPR_BEAM_WIDTH=12

# ------------------------------------------------------------------- видеопоток
# У фото и видео разные оптимумы. На фото один кадр и один шанс — берём полноту.
# На видео кадров десятки, зато важна частота: детектор мельче, мелкие пластины
# отбрасываем, прочитанный номер не перечитываем без повода.
#
# Замер на размеченном видео 1280x720, 1163 кадра, 9 проверяемых номеров:
#   было  (640, порог 24, чтение каждый кадр)   5.9 FPS   9/9   7 ложных
#   стало (480, порог 70, чтение по нужде)     19.0 FPS   9/9   1 ложное
# Проверяется автоматически: ANPR_TEST_VIDEO=<путь> pytest tests/test_video.py -s
ANPR_STREAM_DET_IMGSZ=480       # 0 = как ANPR_DET_IMGSZ (то есть без разницы с фото)
# Кроп уже 70 px модель читает уверенно и неправильно: пластина 58x28 давала мусор
# с conf 0.965 и валидным форматом, причём её не смог прочитать и человек.
# Лучше промолчать, чем выдать правдоподобный неверный номер.
ANPR_STREAM_MIN_PLATE_WIDTH=70  # 0 = как ANPR_MIN_PLATE_WIDTH
# Главный выключатель экономии: false возвращает чтение каждой пластины в каждом кадре.
ANPR_SKIP_CONFIRMED=true
# Перечитать подтверждённый номер, если пластина выросла во столько раз (машина
# подъехала, кадр лучше). Без этого теряются номера, закрепившиеся по дальним
# кадрам — на замере два из девяти.
ANPR_RECHECK_GROWTH=1.4
# ...либо просто раз в столько кадров обработки — страховка от застоя.
ANPR_RECHECK_FRAMES=15

# ---------------------------------------------------------------------- трекинг
ANPR_TRACK_IOU=0.25
ANPR_TRACK_MAX_AGE=20
# Доклейка трека по совпадению текста, когда IoU не сработал. Нужна на подвижной
# камере: при съёмке на ходу один номер разваливался на 9 треков и давал дубли.
ANPR_TRACK_BY_TEXT=true
ANPR_MIN_VOTES=3                # сколько кадров подряд должны согласиться на событие
ANPR_EVENT_COOLDOWN_S=8.0

# --------------------------------------------------------------------- хранение
ANPR_DB_PATH=data/anpr.db
ANPR_SAVE_SNAPSHOTS=true
ANPR_SNAPSHOT_DIR=data/snapshots

# ----------------------------------------------------------------------- сервер
ANPR_API_KEY=                   # если задан — нужен заголовок X-API-Key (или ?api_key=)
ANPR_CORS_ORIGINS=*
ANPR_WS_JPEG_QUALITY=70
